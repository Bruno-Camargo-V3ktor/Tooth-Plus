# ==========================================
# 🚀 CORE SERVER CONFIGURATION
# ==========================================
SERVER_PORT=8080
FRONTEND_URL=*
API_BASE_URL=

# ==========================================
# 🗄️ DATABASE (SURREALDB)
# ==========================================
DB_HOST=127.0.0.1:8000
DB_USER=root
DB_PASS=password
DB_NS=namespace
DB_DB=database
MIGRATIONS_DIR=/migrations

# ==========================================
# 🔒 SECURITY & CRYPTO
# ==========================================
JWT_SECRET=super_secret_key_from_env_file
ENCRYPTION_KEY=01234567890123456789012345678901

# ==========================================
# 📂 STORAGE ENGINE (FILES & MEDIA)
# ==========================================
STORAGE_PROVIDER=local
STORAGE_BUCKET=./uploads
STORAGE_PUBLIC_URL=http://localhost:8080/uploads
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ==========================================
# 💬 EVOLUTION API (WHATSAPP)
# ==========================================
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=01234567890123456789012345678901
